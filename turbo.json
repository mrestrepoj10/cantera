{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "globalPassThroughEnv": ["APS_E2E"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "APS_CLIENT_ID",
        "APS_CLIENT_SECRET",
        "APS_VIEWER_DEMO_URN",
        "APS_AUTH_BASE_URL",
        "SESSION_SECRET",
        "ACC_AUTH_DEMO"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "registry:build": {
      "cache": false
    },
    "registry:verify": {
      "cache": false
    },
    "typecheck": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
