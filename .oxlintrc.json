{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Anti-slop only: Biome owns general linting and the ESLint gate owns the
  // consumer dialect over apps/www/registry/**. Oxlint runs just the vendored
  // anti-slop plugin, so every default category stays off.
  "categories": {
    "correctness": "off"
  },
  "ignorePatterns": [
    ".claude/**",
    "skills/**",
    "tools/oxlint/anti-slop/**",
    "vendor/**",
    "apps/www/components/ui/**",
    "apps/www/components/site/demos.generated.tsx",
    "**/.next/**",
    "**/public/r/**",
    "test-results/**",
    "playwright-report/**"
  ],
  "jsPlugins": [{ "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" }],
  "rules": {
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    // Off: `typeof x === 'number'` narrowing of primitive unions
    // ('sm' | 'md' | number) and documented thenable checks are idiomatic
    // TypeScript, which is what every finding in this repo was.
    "anti-slop/no-runtime-typeof": "off",
    // Off: crew-avatar draws literal SVG shapes — "shape" is the domain noun
    // here, not structural naming.
    "anti-slop/no-shape-in-symbol-names": "off",
    // Off: caught errors are `unknown` by construction, so catch-boundary
    // helpers (`failureMessage(error: unknown)`) are the parse-at-boundary
    // pattern this rule wants, not laundering. Every finding in this repo was
    // that shape or the SDK boundary in overrides below.
    "anti-slop/no-unknown-parameters": "off",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    // Deferred policy decision: adopting a SAFETY:-comment convention is
    // tracked separately; until then assertions carry ordinary justification
    // comments per AGENTS.md's comment policy.
    "anti-slop/require-safety-comment-for-type-assertion": "off"
  },
  "overrides": [
    {
      // The Autodesk Viewer SDK boundary: extension option bags and the
      // members @types/forge-viewer leaves untyped are open `unknown`
      // contracts on purpose — the SDK accepts arbitrary options and ships no
      // types for these surfaces. Everywhere else both rules stay on.
      "files": [
        "apps/www/registry/lib/viewer-types.ts",
        "apps/www/registry/lib/viewer-extension-types.ts",
        "apps/www/registry/lib/forge-viewer.d.ts",
        "apps/www/registry/ui/aps-viewer/**"
      ],
      "rules": {
        "anti-slop/no-unsafe-dictionary-type": "off",
        "anti-slop/no-unknown-returns": "off"
      }
    }
  ]
}
