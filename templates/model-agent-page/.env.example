# Copy to .env.local. The README explains every key.
# Client ID of your APS app (aps.autodesk.com).
APS_CLIENT_ID=
# Client secret of the same APS app.
APS_CLIENT_SECRET=
# Base64 Model Derivative URN of a model Autodesk has already translated, with or without the urn: prefix.
APS_MODEL_URN=
# Vercel AI Gateway key, held by the /api/agent/gateway proxy route and never sent to the browser. Only anthropic/claude-haiku-5.5 is allowed through.
AI_GATEWAY_API_KEY=
