# Copy to .env.local. The README explains every key.
# Client ID of your APS app (aps.autodesk.com).
APS_CLIENT_ID=
# Client secret of the same APS app.
APS_CLIENT_SECRET=
# HMAC key for the session cookie. Generate one with `openssl rand -base64 32`.
SESSION_SECRET=
# Canonical public origin, such as https://app.example.com. On Vercel it defaults to the production URL.
APP_ORIGIN=
# Optional APS origin override, absolute or relative (/emulate/aps) for an embedded emulator. Leave unset for real APS.
APS_AUTH_BASE_URL=
